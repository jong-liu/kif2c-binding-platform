# 複製成 backend/.env 並填值（.env 已被 .gitignore，不會進 repo）。
# 啟動：bash backend/run.sh

JWT_SECRET=請改成一段隨機字串（如 python3 -c "import secrets;print(secrets.token_hex(24))"）
GH_TOKEN=ghp_xxx            # 後端用來 commit job 觸發 Actions；需對 repo 有 contents 寫入權
GH_OWNER=jong-liu
GH_REPO=kif2c-binding-platform
PORT=8000

# 可選：僅在「第一次」建立 data/users.json 時生效（之後密碼存在 users.json，改這裡無效）
# ADMIN_PASSWORD=你的管理者密碼
# DEMO_PASSWORD=你的使用者密碼
