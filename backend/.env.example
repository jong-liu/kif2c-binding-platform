# 複製成 backend/.env 後填入「真值」。.env 已被 gitignore。
# 注意：這是 systemd EnvironmentFile 格式 —— 一行一個 KEY=VALUE，
#       值裡不要加行內註解（# 之後也會被當成值的一部分）。
# 建議直接用下面指令一次生成正確的 .env（不要手動 cp 本範本）：
#
#   cd ~/kif2c-binding-platform/backend
#   printf 'JWT_SECRET=%s\nGH_TOKEN=%s\nGH_OWNER=jong-liu\nGH_REPO=kif2c-binding-platform\nPORT=8000\n' \
#     "$(python3 -c 'import secrets;print(secrets.token_hex(24))')" "$(gh auth token)" > .env
#   chmod 600 .env
#   systemctl --user restart kif2c-api
#
# 各欄位：
#   JWT_SECRET  簽 JWT 用的隨機字串
#   GH_TOKEN    後端用來 commit job 觸發 Actions 的 GitHub token（需 repo 寫入權）
#   GH_OWNER / GH_REPO  目標 repo
#   PORT        後端埠（預設 8000）
JWT_SECRET=
GH_TOKEN=
GH_OWNER=jong-liu
GH_REPO=kif2c-binding-platform
PORT=8000
